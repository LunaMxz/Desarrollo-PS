{
  "info": {
    "_postman_id": "bc9ec7bd-fb48-490d-8d88-f22e41dad405",
    "name": "CU-07 Estado de cuenta del residente",
    "description": "Verifica el estado de cuenta del residente autenticado y el caso sin cargos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "GET mi estado de cuenta",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/unidades/mi-estado-cuenta",
        "description": "Usa el JWT de un residente (POST /auth/login). Para revisar el caso sin historial, usa una unidad sin cargos."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 200', function () { pm.response.to.have.status(200); });",
              "pm.test('incluye unidad, arreglos, resumen y saldo', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.unidad.id).to.be.a('number');",
              "  pm.expect(body.unidad.identificador).to.be.a('string');",
              "  pm.expect(body.cargos).to.be.an('array');",
              "  pm.expect(body.pagos).to.be.an('array');",
              "  pm.expect(body.resumen.total_cargado).to.be.a('number');",
              "  pm.expect(body.resumen.total_pagado).to.be.a('number');",
              "  pm.expect(body.saldo_actual).to.be.a('number');",
              "});",
              "pm.test('sin cargos regresa respuesta vacía válida', function () {",
              "  const body = pm.response.json();",
              "  if (body.cargos.length === 0) {",
              "    pm.expect(body.pagos).to.eql([]);",
              "    pm.expect(body.saldo_actual).to.eql(0);",
              "  }",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
